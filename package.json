{
	"name": "n8n-nodes-lazybird",
	"version": "0.1.0",
	"description": "n8n node for Lazybird: turn text into natural AI voiceovers (MP3), and clone or design voices.",
	"license": "MIT",
	"homepage": "https://github.com/lazybirdai/n8n-nodes-lazybird#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"lazybird",
		"text-to-speech",
		"tts",
		"voiceover",
		"voice-cloning",
		"ai-voice"
	],
	"author": {
		"name": "Lazybird",
		"email": "elyssia@lazybird.app",
		"url": "https://lazybird.app"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lazybirdai/n8n-nodes-lazybird.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LazybirdApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Lazybird/Lazybird.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.53.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/lazybirdai/n8n-nodes-lazybird/issues"
	}
}
